{
  "name": "one-way-git-sync",
  "version": "0.0.0-semantically-released",
  "description": "A tool for synchronizing a destination git repository with a source git repository SAFELY.",
  "keywords": [
    "git",
    "sync"
  ],
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/one-way-git-sync.git"
  },
  "bin": "./bin/index.js",
  "files": [
    "bin/",
    "dist/"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "build-ts app",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "release": "bun run build && semantic-release",
    "start": "bun src/index.ts --",
    "start-prod": "bun run build && bun run one-way-git-sync",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "dependencies": {
    "fs-extra": "11.4.1",
    "micromatch": "4.0.8",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "simple-git": "4.0.2",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/node-ts": "23.6.4",
    "@types/bun": "1.4.4",
    "@types/fs-extra": "11.0.4",
    "@types/micromatch": "4.0.10",
    "@types/node": "26.6.5",
    "@types/yargs": "17.0.35",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "23.0.1",
    "build-ts": "21.0.31",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "lefthook": "2.2.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "25.0.9",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
